# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://ffm_user:ffm_pass@localhost:5432/family_finance?schema=public
POSTGRES_USER=ffm_user
POSTGRES_PASSWORD=ffm_pass
POSTGRES_DB=family_finance

# ─── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Family Finance Manager <noreply@familyfinance.app>"

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# ─── Cloudinary ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Security ──────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ─── App ───────────────────────────────────────────────
INVITE_EXPIRES_HOURS=48
VERIFICATION_EXPIRES_HOURS=24
RESET_TOKEN_EXPIRES_MINUTES=30

# ─── Scheduled jobs ────────────────────────────────────
# Jobs run in-process and are not safe to run on more than one instance at a
# time. Behind a load balancer, set this to false everywhere except one worker.
ENABLE_CRON=true
# Reminders fire on the family's clock, not the server's.
CRON_TIMEZONE=Asia/Kolkata

# ─── Payments & entitlements ────────────────────────────
# Enables the dev-only demo "provider" that completes a pending upgrade through
# the same activation path a real webhook uses. NEVER enable in production.
PAYMENT_DEMO_MODE=false
# Shared HMAC secret the payment provider signs webhook payloads with. Requests
# to /api/v1/subscriptions/webhook are rejected unless its
# `x-webhook-signature` verifies against this. A production deploy with no
# secret fails closed: no upgrade can ever activate.
PAYMENT_WEBHOOK_SECRET=change_me_to_a_long_random_secret

# ─── Seeding (dev only) ─────────────────────────────────
# The seed refuses to run in production unless explicitly allowed.
# SEED_ADMIN_EMAIL=admin@familyfinance.app
# SEED_ADMIN_PASSWORD=use_an_environment_supplied_password
# SEED_ALLOWED_PRODUCTION=true
